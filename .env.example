# Local development settings. Do not commit real credentials.
NODE_ENV=development
PORT=10000
SESSION_SECRET=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql://postgres:password@localhost:5432/flightdeck
# Optional; server-side only
AIRPORTDB_TOKEN=

# Optional welcome email delivery via Resend (leave unset to disable email sending)
RESEND_API_KEY=
EMAIL_FROM="FlyTech <welcome@your-verified-domain.example>"

# Optional exact browser origin(s) when serving the frontend from another host
# FRONTEND_ORIGIN=https://echoairgroup.github.io
# FRONTEND_ORIGINS=https://echoairgroup.github.io,https://app.your-domain.example
